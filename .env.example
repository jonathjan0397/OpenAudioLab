# Secret-free environment template. Copy to .env and fill real values.
# Compose reads this file automatically; the API reads OAL_* from the environment.

# --- Core (VPS control plane) ---
OAL_POSTGRES_PASSWORD=change-me
OAL_OBJECT_ACCESS_KEY=change-me
OAL_OBJECT_SECRET_KEY=change-me

# Exact browser origins, comma-separated (scheme and port included).
OAL_CORS_ORIGINS=https://openaudiolab.io

# --- API (defaults shown) ---
# OAL_PORT=50555
# OAL_BIND_HOST=127.0.0.1
# OAL_DATABASE_URL=sqlite:///./oal.db
# OAL_IDEMPOTENCY_RETENTION_HOURS=24
# OAL_MAX_BODY_BYTES=1048576
# OAL_MAX_LYRICS_CHARS=20000
# OAL_POLL_AFTER_SECONDS=3

# --- Vast.ai remote GPU workers (milestones 2-3) ---
# Remote workers dial out to the control plane; no inbound ports required.
# OAL_OBJECT_ENDPOINT=https://objects.example.internal
# OAL_REDIS_URL=rediss://<host>:6379/0

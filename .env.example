# Secret-free environment template. Copy to .env and fill real values.
# Compose reads this file automatically; the API reads OAL_* from the environment.

# --- Core (VPS control plane) ---
OAL_POSTGRES_PASSWORD=change-me
OAL_OBJECT_ACCESS_KEY=change-me
OAL_OBJECT_SECRET_KEY=change-me
# HMAC key for short-lived download tokens (required; use a long random value).
OAL_SECRET_KEY=change-me

# Exact browser origins, comma-separated (scheme and port included).
OAL_CORS_ORIGINS=https://openaudiolab.io

# --- API (defaults shown) ---
# OAL_PORT=50555
# OAL_BIND_HOST=127.0.0.1
# OAL_DATABASE_URL=sqlite:///./oal.db
# OAL_IDEMPOTENCY_RETENTION_HOURS=24
# OAL_MAX_BODY_BYTES=1048576
# OAL_MAX_LYRICS_CHARS=20000
# OAL_POLL_AFTER_SECONDS=3

# --- Vast.ai remote GPU workers (milestones 2-3) ---
# Remote workers dial out to the control plane; no inbound ports required.
# OAL_OBJECT_ENDPOINT=https://objects.example.internal
# OAL_REDIS_URL=rediss://<host>:6379/0

# --- Audio services (milestone 4) ---
# OAL_MAX_UPLOAD_BYTES=104857600
# OAL_UPLOAD_SESSION_TTL_MINUTES=60
# OAL_FFMPEG_BIN=ffmpeg
# OAL_FFPROBE_BIN=ffprobe
# Separator runtime for stem exports (empty = stems fail closed):
# OAL_DEMUCS_PYTHON=/path/to/engine/.venv/bin/python
# OAL_DEMUCS_MODEL=htdemucs
# OAL_DEMUCS_DEVICE=cpu

# --- Billing ---
# production = Stripe checkout is authoritative; mock subscribe/topup return 409.
# mock = legacy subscribe/topup grant credits immediately (development/tests).
# OAL_BILLING_MODE=production
# OAL_STRIPE_SECRET_KEY=sk_live_...
# OAL_STRIPE_WEBHOOK_SECRET=whsec_...

# --- Artist training (milestone 5) ---
# OAL_TRAIN_MAX_EPOCHS=2000
# OAL_TRAIN_MAX_WALL_SECONDS=7200
# OAL_TRAIN_WORKDIR=./training-data
# OAL_TRAIN_RECIPE_REVISION=acestep-lora@ca1e85f

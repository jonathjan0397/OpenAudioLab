{
  "project": "OpenAudiolab.io",
  "version": "0.1.0-foundation",
  "source_of_truth": "OPENAUDIOLAB_MASTER_PLAN.md",
  "agent_instructions": "AGENTS.md",
  "development_log": "DEVELOPMENT_LOG.md",
  "current_priority": "backend_job_orchestration",
  "default_retention_days": 7,
  "runtime_modes": {
    "no_gpu_backend_mode": true,
    "local_gpu_generation": true,
    "local_gpu_min_vram_gb": 12,
    "cloud_gpu_workers": true
  },
  "security": {
    "first_run_setup_required": true,
    "default_production_credentials_forbidden": true,
    "worker_registration_token_required": true,
    "private_storage_by_default": true,
    "signed_downloads_required": true
  },
  "cloud_compute_providers": [
    "vastai",
    "runpod"
  ],
  "required_storage_adapters": [
    "local",
    "minio",
    "s3_compatible"
  ],
  "preferred_storage_adapters": [
    "amazon_s3",
    "cloudflare_r2",
    "backblaze_b2",
    "wasabi",
    "google_cloud_storage",
    "azure_blob_storage"
  ],
  "pipeline": [
    "job_intake",
    "prompt_validation",
    "lyrics_generation_or_ingestion",
    "lyrics_structure_validation",
    "lyrics_reasoning",
    "lyrics_revision",
    "lyrics_humanization",
    "composition_planning",
    "audio_generation",
    "daw_processing",
    "effects_processing",
    "mastering",
    "preview_waveform_generation",
    "zip_export",
    "storage_upload",
    "signed_download_url",
    "retention_cleanup"
  ],
  "lyrics_modes": {
    "ai": {
      "generate": true,
      "reasoning": true,
      "revision": true,
      "humanization": true,
      "mutates_user_text": false
    },
    "provided": {
      "generate": false,
      "reasoning": false,
      "revision": false,
      "humanization": false,
      "structure_validation_only": true,
      "preserve_exact_text": true
    },
    "hybrid": {
      "generate": true,
      "reasoning": true,
      "revision": true,
      "humanization": true,
      "may_transform_user_input": true
    },
    "instrumental": {
      "skip_all_lyrics_stages": true
    }
  },
  "worker": {
    "unified_container": true,
    "requires_registration": true,
    "requires_heartbeat": true,
    "reports_gpu_capabilities": true,
    "reports_model_packs": true,
    "supports_pull_based_jobs": true,
    "supports_draining": true,
    "supports_update_signaling": true
  },
  "worker_images": [
    "worker-lite",
    "worker-gpu-base",
    "worker-community-full",
    "worker-studio-full"
  ],
  "model_packs": [
    "model-pack-lite",
    "model-pack-community-gpu",
    "model-pack-studio-cloud",
    "model-pack-commercial-safe"
  ],
  "lyric_reasoning": {
    "required_for_ai_generated_lyrics": true,
    "default_mode": "balanced",
    "modes": [
      "off",
      "fast",
      "balanced",
      "strict",
      "studio"
    ],
    "default_minimum_score": 80,
    "default_max_revision_attempts": 3
  },
  "development_governance": {
    "development_log_required": true,
    "development_log_mode": "append_only",
    "task_complete_requires_log_entry": true
  }
}

APP_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=5173

DATABASE_URL=postgresql://openaudiolab:openaudiolab@postgres:5432/openaudiolab
REDIS_URL=redis://redis:6379/0

SECRET_KEY=change-this-before-production
JWT_SECRET=change-this-before-production
CORS_ALLOWED_ORIGINS=http://localhost:5173

STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/data/openaudiolab/storage
DEFAULT_RETENTION_DAYS=7

MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=openaudiolab
MINIO_SECRET_KEY=openaudiolab-secret
MINIO_BUCKET=openaudiolab-jobs

WORKER_REGISTRATION_TOKEN=change-this-worker-token
WORKER_VERSION=0.1.0
WORKER_MODE=lite

ENABLE_CPU_TEST_GENERATION=true
CPU_TEST_MAX_DURATION_SECONDS=15

SEED_DEV_ADMIN=false

RUNPOD_API_KEY=
VASTAI_API_KEY=
ENABLE_CLOUD_WORKERS=false

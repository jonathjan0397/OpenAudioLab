{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenAudiolab Manifest Schema",
  "type": "object",
  "required": ["project", "version", "source_of_truth"],
  "properties": {
    "project": { "type": "string" },
    "version": { "type": "string" },
    "source_of_truth": { "type": "string" },
    "agent_instructions": { "type": "string" },
    "development_log": { "type": "string" },
    "current_priority": { "type": "string" },
    "default_retention_days": { "type": "integer" },
    "runtime_modes": { "type": "object" },
    "security": { "type": "object" },
    "pipeline": { "type": "array", "items": { "type": "string" } },
    "lyrics_modes": { "type": "object" },
    "worker": { "type": "object" },
    "model_packs": { "type": "array", "items": { "type": "string" } }
  }
}

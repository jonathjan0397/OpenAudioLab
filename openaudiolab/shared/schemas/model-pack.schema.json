{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenAudiolab Model Pack Schema",
  "type": "object",
  "required": ["model_pack_id", "display_name", "models"],
  "properties": {
    "model_pack_id": { "type": "string" },
    "display_name": { "type": "string" },
    "description": { "type": "string" },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "task"],
        "properties": {
          "id": { "type": "string" },
          "task": { "type": "string" },
          "path": { "type": "string" },
          "required": { "type": "boolean", "default": false },
          "min_vram_gb": { "type": "integer", "default": 0 },
          "commercial_safe": { "type": ["boolean", "string"] },
          "redistributable": { "type": ["boolean", "string"] }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenAudiolab Job Schema",
  "type": "object",
  "required": ["prompt", "lyrics_mode"],
  "properties": {
    "prompt": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "genre": { "type": "string", "maxLength": 100 },
    "mood": { "type": "string", "maxLength": 255 },
    "lyrics_mode": { "type": "string", "enum": ["ai", "provided", "hybrid", "instrumental"] },
    "provided_lyrics": { "type": ["string", "null"], "maxLength": 10000 },
    "instrumental": { "type": "boolean", "default": false },
    "duration_seconds": { "type": "integer", "minimum": 5, "maximum": 600, "default": 90 },
    "vocal_mode": { "type": "string", "default": "male" },
    "quality": { "type": "string", "enum": ["draft", "standard", "high", "studio"], "default": "draft" },
    "dispatch_preference": { "type": "string", "enum": ["auto", "local", "remote_worker", "cloud_gpu", "cpu_test"], "default": "auto" },
    "lyric_reasoning_mode": { "type": "string", "enum": ["off", "fast", "balanced", "strict", "studio"], "default": "balanced" },
    "storage_retention_days": { "type": "integer", "minimum": 1, "maximum": 365, "default": 7 }
  }
}

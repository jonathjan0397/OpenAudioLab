{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenAudiolab Worker Schema",
  "type": "object",
  "required": ["worker_name", "registration_token"],
  "properties": {
    "worker_id": { "type": "string" },
    "worker_name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "worker_mode": { "type": "string", "enum": ["lite", "gpu_base", "community_full", "studio_full"], "default": "lite" },
    "hostname": { "type": "string" },
    "registration_token": { "type": "string", "minLength": 1 },
    "gpu": {
      "type": "object",
      "properties": {
        "available": { "type": "boolean", "default": false },
        "name": { "type": ["string", "null"] },
        "vram_gb": { "type": "number", "default": 0 },
        "cuda_available": { "type": "boolean", "default": false }
      }
    },
    "capabilities": { "type": "object" },
    "model_packs": { "type": "array", "items": { "type": "string" } },
    "container_version": { "type": "string", "default": "0.1.0" }
  }
}

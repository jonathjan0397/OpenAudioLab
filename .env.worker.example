# Remote worker node environment (secret-free template; copy to .env.worker).
# The hub address (OAL_HUB) is the backend's WireGuard address, e.g. 10.203.0.1.

# WireGuard hub address the node dials to for backend services.
OAL_HUB=10.203.0.1

# Prebuilt combined worker image (pulled, not built, on the node).
OAL_WORKER_IMAGE=stratastack/oal-worker:ca1e85f-torch2.10-cu128

# Worker roles to run against the co-located ACE-Step server.
OAL_WORKER_ROLE=engine_worker,training_worker

# Backend credentials (same values as the hub's .env; delivered out of band).
OAL_POSTGRES_PASSWORD=change-me
OAL_OBJECT_ACCESS_KEY=change-me
OAL_OBJECT_SECRET_KEY=change-me
OAL_ACESTEP_API_KEY=

# Object storage bucket on the hub (MinIO).
OAL_S3_BUCKET=oal
OAL_S3_REGION=us-east-1

# S3 endpoint over the tunnel (hub publishes it on its wg address).
OAL_S3_ENDPOINT_URL=http://10.203.0.1:9000
